# ==========================================
# MULTI-PROVIDER LLM ADAPTER CONFIGURATION
# ==========================================

# Lựa chọn LLM Provider: "gemini", "openai", "groq", hoặc "mock" (offline)
LLM_PROVIDER=gemini

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-2.5-flash

# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here
# LLM_MODEL=gpt-4o-mini

# Groq API Key: https://console.groq.com/keys
# Chọn LLM_PROVIDER=groq để sử dụng provider này
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-safeguard-20b

# Demo: hồ sơ người dùng hiện tại (ứng dụng thật nên lấy giá trị này từ phiên đăng nhập)
# Điền một mã có sẵn trong MOCK_DATABASE để demo câu hỏi "của tôi" mà không gửi mã mỗi lần.
CURRENT_STUDENT_ID=

# Anthropic API Key
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# LLM_MODEL=claude-3-5-haiku-20241022

# MCP Configuration
MCP_SERVER_HOST=localhost
MCP_SERVER_PORT=8000
